# Local development only. Never use these example credentials for a hosted pilot.
DATABASE_URL=postgresql://family:family@localhost:55432/family_network_dev
# Integration tests require a dedicated, disposable database ending in _test.
TEST_DATABASE_URL=postgresql://family:family@localhost:55432/family_network_test
SEED_DIR=seed/fixtures
SEED_SOURCE=synthetic-development-v1


# Generate a secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
MAIL_TRANSPORT=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Family Network <auth@example.test>
# Production: MAIL_TRANSPORT=smtp, HTTPS origin, SMTP_PORT=465 and TLS SMTP credentials.
# SMTP_USER=
# SMTP_PASSWORD=
# AUTH_IP_HEADER=your-host-sanitized-client-ip-header
